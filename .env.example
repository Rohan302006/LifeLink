# LifeLink Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=lifelink-hackathon-super-secret-key-2026

# PostgreSQL / NeonDB Connection String
# Leave empty for high-speed zero-config local memory engine
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/lifelink?sslmode=require

# Google Gemini API Key (Server-side wrapper for AI Assistant & Emergency Intake)
# If left empty, intelligent local rule-based assistant & multi-lingual fallbacks activate automatically
GEMINI_API_KEY=

# OTP Provider: 'mock' (default for evaluation/demo) or 'twilio'
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notification Email (Optional - defaults to mock logger & in-app stream)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

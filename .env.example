# ==============================================================================
# LifeLink Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key (Generate a secure random string for production)
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database Connection String (Neon)
# Example: postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/lifelink?sslmode=require
DATABASE_URL=postgresql://your_neon_user:your_neon_password@your_neon_host/lifelink?sslmode=require

# Database Demo Accounts & Initial Setup
# (Change this to update all 4 default accounts: admin, doctor, donor, receiver)
DEMO_PASSWORD=Password123!

# Private Document Uploads Storage Path (Defaults to server/uploads/private)
UPLOAD_DIR=
